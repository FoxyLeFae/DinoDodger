  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  questions:
  - questionText: What is it called when consent must be freely given without pressure?
    correctAnswer: Voluntary
    wrongAnswer: Specific
  - questionText: What ensures there are no disadvantages to refusing consent?
    correctAnswer: Voluntary
    wrongAnswer: Informed
  - questionText: What means implied consent is not valid?
    correctAnswer: Unequivocal
    wrongAnswer: Voluntary
  - questionText: What type of consent requires a clear and explicit action?
    correctAnswer: Unequivocal
    wrongAnswer: Specific
  - questionText: What is it called when users know their rights before agreeing?
    correctAnswer: Informed
    wrongAnswer: Unequivocal
  - questionText: What requirement ensures users are properly educated about consent?
    correctAnswer: Informed
    wrongAnswer: Voluntary
  - questionText: What requires consent to be linked to a specific purpose?
    correctAnswer: Specific
    wrongAnswer: Informed
  - questionText: What means consent must relate to a defined assignment or task?
    correctAnswer: Specific
    wrongAnswer: Voluntary
  - questionText: What is required for documenting consent properly?
    correctAnswer: Written or digital
    wrongAnswer: Handwritten only
  - questionText: For how long do you keep the data?
    correctAnswer: Only for as long as it's needed
    wrongAnswer: For as long as you fell like
  questionTextUI: {fileID: 2111995524}
  button1Text: {fileID: 85695131}
  button2Text: {fileID: 1785284725}
